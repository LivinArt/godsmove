# GODSMOVE Environment Variables Example
# Copy this file to .env.local for local development or add these keys to Vercel Environment Variables

# Supabase Public API Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (Server-side admin operations only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PostgreSQL Database Connections (Prisma ORM)
# Pooler Connection (Port 6543, pgbouncer)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct Connection (Port 5432, for migrations)
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Razorpay Payment Gateway (Test / Live credentials)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Application Metadata & Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GODSMOVE

# Optional Development Mode Flags
NEXT_PUBLIC_DEV_MODE=false
